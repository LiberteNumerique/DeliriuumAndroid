<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Accès Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Deliriuum"
        tools:targetApi="31">

        <activity
            android:name=".ui.screens.GeckoBrowserActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.GeckoPopupActivity"
            android:exported="false"
            android:theme="@style/Theme.Deliriuum" />

        <!--
            Audit AVANT Deliriuum.

            Processus séparé obligatoire afin de disposer d'un GeckoRuntime
            standard, distinct du DeliriumGeckoRuntime protégé du processus
            principal.
        -->
        <activity
            android:name=".data.BaselineAuditActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:process=":privacy_audit"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            PAS de ProtectedAuditActivity.
            L'audit APRÈS utilise le DeliriumGeckoRuntime existant dans HomeView.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Deliriuum">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WireGuard / Android VpnService -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">

            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
